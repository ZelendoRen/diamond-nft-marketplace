# Copy to .env, never commit it

SEPOLIA_RPC_URL=
# throwaway testnet account (0x...)
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# true prints a gas report after the tests
REPORT_GAS=false

# Deployment settings (scripts/deploy.ts), all optional
COLLECTION_NAME=Diamond Collection
COLLECTION_SYMBOL=DIA
# ERC-721 base URI, empty means token URIs are stored in full
BASE_URI=
# ERC-1155 URI template, for example https://example.com/{id}.json
MULTI_TOKEN_URI=
# default royalty in basis points (500 = 5%), receiver defaults to the owner
ROYALTY_BPS=500
ROYALTY_RECEIVER=
